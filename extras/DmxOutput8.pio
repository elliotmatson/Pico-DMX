; Author: Jostein Løwer, github: jostlowe
; SPDX-License-Identifier: BSD-3-Clause
;
; PIO program for outputting 8 DMX universes simultaneously on 8 consecutive pins.
; Compliant with ANSI E1.11-2008 (R2018)
; The program assumes a PIO clock frequency of exactly 1MHz
;
; Data format: caller supplies a pre-packed bit-plane buffer.
; One 32-bit word per bit-time; lower 8 bits drive the 8 output pins:
;   bit k -> pin (OUT_BASE + k)  = universe k,  k in 0..7
;
; Each DMX byte expands to 11 words:
;   word  0      : start bit  (0x00000000 - all pins LOW)
;   words 1..8   : data bits, LSB first (bit k of word = bit from universe k)
;   words 9..10  : stop bits  (0x000000FF - all pins HIGH)

.program DmxOutput8

; Assert break condition for 176us (22 iterations x 8 cycles at 1MHz)
    set x, 21                   ; Preload counter (loop runs x+1 = 22 times)
breakloop:
    mov pins, null      [6]     ; Drive 8 pins LOW  (1 + 6 = 7 cycles, bypasses OSR)
    jmp x-- breakloop           ; Decrement and loop (1 cycle) -- 8 cycles total per iteration

; Assert MAB (Mark After Break) for 16us
    mov pins, ~null     [15]    ; Drive 8 pins HIGH (1 + 15 = 16 cycles, bypasses OSR)

; Stream pre-packed bit-plane words (autopull, threshold = 8)
.wrap_target
    out pins, 8         [3]     ; Output 8 bits (1 per universe), 1 + 3 = 4 cycles = 4us per bit
.wrap
